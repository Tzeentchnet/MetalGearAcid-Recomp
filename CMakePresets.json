{
  "version": 6,
  "configurePresets": [
    {
      "name": "clang-cl",
      "displayName": "clang-cl (x64, Ninja, Release)",
      "description": "VS 2022 Build Tools clang-cl. Run from a VS x64 developer shell.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_BUILD_TYPE": "Release",
        "MGA_ENABLE_D3D12": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "clang-cl-d3d12",
      "inherits": "clang-cl",
      "displayName": "clang-cl + D3D12 (x64, Ninja, Release)",
      "description": "D3D12 renderer build. Pass SDL3_DIR or CMAKE_PREFIX_PATH to an SDL3 development package.",
      "cacheVariables": {
        "MGA_ENABLE_D3D12": "ON"
      }
    },
    {
      "name": "clang-cl-vulkan",
      "inherits": "clang-cl",
      "displayName": "clang-cl + Vulkan (x64, Ninja, Release)",
      "description": "Vulkan renderer build. Pass SDL3_DIR and install the Vulkan SDK.",
      "cacheVariables": {
        "MGA_ENABLE_VULKAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "clang-cl",
      "configurePreset": "clang-cl"
    },
    {
      "name": "clang-cl-d3d12",
      "configurePreset": "clang-cl-d3d12"
    },
    {
      "name": "clang-cl-vulkan",
      "configurePreset": "clang-cl-vulkan"
    }
  ]
}
